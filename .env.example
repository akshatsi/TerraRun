# Values for docker-compose.prod.yml. Copy this file to .env and fill it in.
# .env is ignored by git. Never commit the real values.

# Database account. Use only letters and digits in the password: it goes into
# a URL. Generate one with: openssl rand -hex 24
POSTGRES_USER=terrarun
POSTGRES_PASSWORD=
POSTGRES_DB=terrarun

# Signs login tokens. Generate one with: openssl rand -hex 32
SECRET_KEY=

# HTTPS with Caddy: docker compose -f docker-compose.prod.yml --profile https up -d
# DOMAIN is the name that points at this server. BACKEND_BIND=127.0.0.1 keeps
# port 8000 off the network, since Caddy reaches the backend inside Docker.
# DOMAIN=api.example.com
# BACKEND_BIND=127.0.0.1

# Optional. Comma-separated origins allowed to call the API from a browser,
# for a deployed web build. Leave empty for a mobile-only release.
CORS_ORIGINS=
