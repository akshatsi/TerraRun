# Settings for the backend. Set these in the host's environment, or copy this
# file to .env and pass it with `docker run --env-file`. Never commit the
# real values.

# PostgreSQL with the PostGIS extension. postgres:// is also accepted.
DATABASE_URL=postgresql://terrarun:CHANGE_ME@localhost:5432/terrarun

# Signs login tokens. Generate one with: openssl rand -hex 32
# The backend refuses to start if this is empty or still the placeholder.
SECRET_KEY=change-this-to-a-long-random-secret

# Use "development" on your own machine to allow an insecure fallback
# SECRET_KEY. Leave it as "production" everywhere else.
APP_ENV=production

# Optional. Comma-separated origins allowed to call the API from a browser,
# for a deployed web build. localhost is always allowed.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=
